# Local binding only. Do not expose the gateway to the network by default.
ZV67_HOST=127.0.0.1
ZV67_PORT=18080

# Optional local API key. Empty means no authentication, valid only for localhost.
ZV67_API_KEY=

ZV67_REQUEST_TIMEOUT_SECONDS=120
ZV67_MAX_MESSAGES=200
ZV67_MAX_MESSAGE_CHARS=200000
ZV67_LOG_LEVEL=INFO

# Experimental Google AI Mode backend through a real Chrome CDP session.
ZV67_GOOGLE_AI_MODE_ENABLED=false
ZV67_GOOGLE_BROWSER_MAX_SESSIONS=2
ZV67_GOOGLE_BROWSER_TIMEOUT_SECONDS=60
ZV67_GOOGLE_BROWSER_HEADLESS=true

